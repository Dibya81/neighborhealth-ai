# Copy to apps/api/.env and fill in. Never commit the real .env.
APP_ENV=development
NH_CITY=bengaluru

# SQLite by default (zero setup). Docker uses Postgres + PostGIS:
# DATABASE_URL=postgresql://nh:nh@localhost:5432/neighborhealth
# REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# LLM (assistant + explanations + PDF extraction)
OPENROUTER_API_KEY=
NH_LLM_MODEL=google/gemini-2.0-flash-001

# Alerts: keep dry-run on until you've tested; then set credentials and ALERTS_DRY_RUN=false
ALERTS_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional
VISION_ENABLED=false
SENTRY_DSN=
MLFLOW_TRACKING_URI=
